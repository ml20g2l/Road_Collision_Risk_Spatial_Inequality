{
  "model": "Road Collision Risk & Spatial Inequality",
  "grain": {
    "fact_collision": "collision_index",
    "fact_local_authority_year_risk": "collision_year + local_authority_highway_current",
    "fact_exposure_sensitivity": "collision_year + scenario_key"
  },
  "relationships": [
    {
      "from": "fact_collision.date_key",
      "to": "dim_date.date_key",
      "cardinality": "many-to-one"
    },
    {
      "from": "fact_collision.lsoa_code_2021",
      "to": "dim_lsoa.lsoa_code_2021",
      "cardinality": "many-to-one"
    },
    {
      "from": "fact_collision.local_authority_highway_current",
      "to": "dim_local_authority.local_authority_highway_current",
      "cardinality": "many-to-one"
    },
    {
      "from": "fact_exposure_sensitivity.scenario_key",
      "to": "dim_exposure_scenario.scenario_key",
      "cardinality": "many-to-one"
    }
  ],
  "certified_metrics": {
    "Collision Count": "COUNTROWS(fact_collision)",
    "Raw KSI": "SUM(fact_collision[is_fatal_or_serious_raw])",
    "Adjusted Expected KSI": "SUM(fact_collision[expected_adjusted_ksi])",
    "Raw KSI per Billion Vehicle Miles": "DIVIDE(SUMX(FILTER(fact_local_authority_year_risk, fact_local_authority_year_risk[exposure_available]), fact_local_authority_year_risk[raw_ksi]),SUM(fact_local_authority_year_risk[annual_vehicle_miles]))*1000000000",
    "Adjusted KSI per Billion Vehicle Miles": "DIVIDE(SUMX(FILTER(fact_local_authority_year_risk, fact_local_authority_year_risk[exposure_available]), fact_local_authority_year_risk[adjusted_expected_ksi]),SUM(fact_local_authority_year_risk[annual_vehicle_miles]))*1000000000"
  },
  "guardrail": "AADF scenarios are coverage/sensitivity diagnostics only until road-segment geometry matching is implemented; do not expose them as absolute risk rates."
}